{
  "name": "tcc-platform",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.4",

  "workspaces": [
    "apps/*",
    "packages/*"
  ],

  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "generate": "pnpm --filter @tcc/db exec prisma generate"
  },

  "devDependencies": {
    "turbo": "^2.10.5"
  }
}