NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://tcc_user:tcc_password@localhost:5432/tcc_platform?schema=public"
JWT_ACCESS_SECRET=GENERATE_WITH_crypto.randomBytes(64).toString('hex')
JWT_REFRESH_SECRET=GENERATE_WITH_crypto.randomBytes(64).toString('hex')_DIFFERENT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12

# Which provider powers Copilot chat/agent completions. "groq" (default)
# only needs GROQ_API_KEY below; "openrouter" only needs the OPENROUTER_*
# vars below — you never need both at once, only whichever this selects.
AI_PROVIDER=groq

# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (https://openrouter.ai) — only used when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Required when AI_PROVIDER=openrouter — e.g. openai/gpt-oss-20b,
# anthropic/claude-3.5-sonnet, or any other OpenRouter model slug that
# supports tool/function calling (Copilot's agent loop requires it).
OPENROUTER_MODEL=
# Optional — OpenRouter's recommended (not required) attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Copilot agent loop limits (optional — sensible defaults apply)
COPILOT_MAX_AGENT_STEPS=5
COPILOT_PROVIDER_TIMEOUT_MS=20000
COPILOT_TOOL_TIMEOUT_MS=10000
# Copilot AI provider retry policy (optional — sensible defaults apply)
COPILOT_PROVIDER_MAX_RETRIES=2
COPILOT_PROVIDER_INITIAL_BACKOFF_MS=500
COPILOT_PROVIDER_MAX_BACKOFF_MS=8000
COPILOT_PROVIDER_MAX_TOTAL_MS=45000
COPILOT_PENDING_ACTION_TTL_MS=300000

# Copilot: hybrid semantic memory/conversation retrieval (optional —
# sensible defaults apply). Set to false to roll back instantly to
# deterministic-only retrieval.
COPILOT_SEMANTIC_RETRIEVAL_ENABLED=true

# Which embedding backend to use. "groq" (default) reuses GROQ_API_KEY
# above — no separate key needed, but note some Groq accounts have no
# embedding-model access (semantic retrieval then falls back to
# deterministic-only automatically; nothing breaks). "openai-compatible"
# calls COPILOT_EMBEDDING_BASE_URL directly — use this for OpenAI itself,
# or a local/self-hosted server (Ollama, LM Studio, vLLM, ...) that exposes
# the same POST /embeddings shape.
COPILOT_EMBEDDING_PROVIDER=groq
COPILOT_EMBEDDING_MODEL=nomic-embed-text-v1_5
# Required only when COPILOT_EMBEDDING_PROVIDER=openai-compatible, e.g.
# https://api.openai.com/v1 or http://localhost:11434/v1 for local Ollama.
COPILOT_EMBEDDING_BASE_URL=
# Optional — many local/self-hosted servers need no key at all.
COPILOT_EMBEDDING_API_KEY=
# Optional — only sent when set (e.g. OpenAI's text-embedding-3-* models
# accept a `dimensions` field to truncate their native output size).
COPILOT_EMBEDDING_DIMENSIONS=
COPILOT_EMBEDDING_TIMEOUT_MS=5000
COPILOT_SEMANTIC_SIMILARITY_THRESHOLD=0.55