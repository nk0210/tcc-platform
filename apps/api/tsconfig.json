{
  "compilerOptions": {
    "target": "ES2020",

    "module": "Node16",
    "moduleResolution": "Node16",

    "lib": ["ES2020"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "outDir": "./dist",
    "rootDir": "./src",

    "resolveJsonModule": true,
    "declaration": false,

    "ignoreDeprecations": "5.0",

    "paths": {
      "@tcc/types": [
        "../../packages/types/src/index.ts"
      ],
      "@tcc/types/*": [
        "../../packages/types/src/*"
      ]
    }
  },

  "include": [
    "src"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}